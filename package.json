{
  "name": "jumpygoat-hq",
  "private": true,
  "packageManager": "pnpm@10.10.0",
  "scripts": {
    "build": "pnpm --filter @jumpygoat-hq/runner build && pnpm --filter @jumpygoat-hq/web build",
    "check:design": "node scripts/check-design-system.mjs",
    "hooks:install": "git config core.hooksPath .githooks",
    "prepare": "git config core.hooksPath .githooks || true",
    "setup:db": "pnpm --filter @jumpygoat-hq/runner exec tsx ../../scripts/setup-db.ts",
    "doctor": "pnpm --filter @jumpygoat-hq/runner exec tsx ../../scripts/doctor.ts",
    "install:cron": "pnpm --filter @jumpygoat-hq/runner exec tsx ../../scripts/install-cron.ts",
    "uninstall:cron": "pnpm --filter @jumpygoat-hq/runner exec tsx ../../scripts/uninstall-cron.ts",
    "list:cron": "pnpm --filter @jumpygoat-hq/runner exec tsx ../../scripts/list-cron.ts",
    "install:task-cron": "pnpm --filter @jumpygoat-hq/runner exec tsx ../../scripts/install-task-heartbeat-cron.ts",
    "uninstall:task-cron": "pnpm --filter @jumpygoat-hq/runner exec tsx ../../scripts/uninstall-task-heartbeat-cron.ts",
    "list:task-cron": "pnpm --filter @jumpygoat-hq/runner exec tsx ../../scripts/list-task-heartbeat-cron.ts",
    "runner": "pnpm --filter @jumpygoat-hq/runner start",
    "dispatch:tasks": "pnpm --filter @jumpygoat-hq/runner exec tsx ../../scripts/dispatch-tasks.ts",
    "web": "pnpm --filter @jumpygoat-hq/web start",
    "dev": "pnpm --filter @jumpygoat-hq/runner dev",
    "dev:web": "pnpm --filter @jumpygoat-hq/web dev",
    "validate:web": "pnpm --filter @jumpygoat-hq/web build && playwright test",
    "validate:backend": "pnpm --filter @jumpygoat-hq/runner exec tsx ../../scripts/smoke-runner.ts",
    "validate": "pnpm validate:web && pnpm validate:backend"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "typescript": "^5.9.3"
  }
}
