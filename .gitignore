node_modules/
dist/
.env
.env.local
.DS_Store

# Runtime/local instance state. Keep the public repo as a template;
# personal agents, automations, run history, traces, and workspaces stay private.
data/
traces/
test-results/
playwright-report/
workspaces/
automations/*
!automations/
!automations/README.md
agents/*
!agents/
!agents/README.md

# Local task queues/history. Keep canonical changelog in git.
tasks/todo/
tasks/done/
!tasks/CHANGELOG.md

# Canonical mutable local workspace. Keep docs, ignore active state.
workspace/data/
workspace/traces/
workspace/workspaces/
workspace/settings.yml
workspace/automations/*
!workspace/automations/
!workspace/automations/README.md
workspace/agents/*
!workspace/agents/
!workspace/agents/README.md
workspace/boards/*
!workspace/boards/
!workspace/boards/README.md
workspace/projects/*
!workspace/projects/
!workspace/projects/README.md
