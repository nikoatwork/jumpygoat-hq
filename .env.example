# Copy this file to .env.local for personal/local secrets and overrides.
# .env.local is gitignored; .env.example is safe to commit.
#
# Pi auth is preferred when possible:
#   1. SSH into the server as the user that will run cron.
#   2. Run: pi /login
#   3. jumpyGoatHq will reuse Pi's stored auth.

# Optional provider key override, e.g. Vercel AI Gateway.
# Use whatever env vars your Pi provider config expects.
VERCEL_AI_GATEWAY_API_KEY=

# Optional Firecrawl web connector for web_search/web_scrape/web_crawl Pi tools.
FIRECRAWL_API_KEY=

# Optional Resend notification connector.
# 1. Verify a sender/domain in Resend.
# 2. Put the secret API key here or in the cron environment.
# 3. Put non-secret defaults here or override them in agent/automation frontmatter.
RESEND_API_KEY=
JUMPYGOATHQ_NOTIFY_EMAIL_TO=
JUMPYGOATHQ_NOTIFY_EMAIL_FROM="jumpyGoatHq <agent@example.com>"
JUMPYGOATHQ_NOTIFY_SUBJECT_PREFIX="[jumpyGoatHq] "

# Optional AgentMail two-way mail connector for mail_send/mail_list Pi tools.
# Create/verify an AgentMail account or agent, then put only the secret key here.
# Non-secret defaults can live here or in agent/automation frontmatter.
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX_ID="agent@agentmail.to"
AGENTMAIL_TO=
AGENTMAIL_SUBJECT_PREFIX=""

# Optional Cloudflare R2 artifact connector for artifact_upload.
# Create an R2 bucket and an API token with object read/write access to that bucket.
# The connector uploads private objects and returns 7-day presigned download URLs by default.
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=
# Optional artifact defaults:
JUMPYGOATHQ_ARTIFACT_EXPIRES_SECONDS=604800
JUMPYGOATHQ_ARTIFACT_MAX_FILE_BYTES=25000000
JUMPYGOATHQ_ARTIFACT_UPLOAD_TIMEOUT_MS=60000

# Optional: override the mutable instance root.
# Defaults to repoRoot()/workspace.
# JUMPYGOATHQ_HOME=/var/lib/jumpygoat-hq

# Optional: require a bearer token for /api/... JSON API routes.
# Recommended before exposing the web/API server beyond localhost, even behind HTTPS/proxy/Tailscale.
# CLI remote mode sends this as Authorization: Bearer <token> when configured with --token or JUMPYGOATHQ_TOKEN.
# JUMPYGOATHQ_API_TOKEN=change-me-long-random-token

# Optional: override where local run history is stored.
# Defaults to jumpyGoatHqHome()/data/jumpygoat-hq.sqlite.
# Relative paths resolve under jumpyGoatHqHome().
# JUMPYGOATHQ_DB_PATH=data/jumpygoat-hq.sqlite
